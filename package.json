{
  "name": "homecoming",
  "version": "0.1.0",
  "description": "Open source engine that diagnoses why a wallet connect or crypto purchase failed, then wins the user back safely.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "train": "tsx eval/train.ts",
    "eval": "tsx eval/run.ts",
    "start": "tsx src/server/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
